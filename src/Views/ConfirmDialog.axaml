<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.ConfirmDialog"
        x:DataType="vm:ConfirmDialogViewModel"
        Title="{Binding Title}"
        Width="520" SizeToContent="Height"
        MinWidth="420"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <!-- No outer margin: the grey upper part reaches from window side to window side. -->
    <Grid RowDefinitions="*,Auto">

        <Border Grid.Row="0"
                MinHeight="140"
                Padding="16"
                Background="#101010">
            <TextBlock Text="{Binding Message}"
                       FontSize="14"
                       TextWrapping="Wrap"
                       TextAlignment="Left"
                       VerticalAlignment="Center"/>
        </Border>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Spacing="5"
                    HorizontalAlignment="Right"
                    Margin="10">
            <Button Content="Cancel"
                    Command="{Binding CancelCommand}"
                    MinWidth="90"
                    IsDefault="True"
                    IsCancel="True"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button Content="{Binding ConfirmButtonText}"
                    Command="{Binding ConfirmCommand}"
                    MinWidth="90"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#E53935"
                    Foreground="White"/>
        </StackPanel>
    </Grid>
</Window>
