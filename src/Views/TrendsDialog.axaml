<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
    xmlns:controls="using:PentaGrammata.Views.Controls"
        x:Class="PentaGrammata.Views.TrendsDialog"
        x:DataType="vm:TrendsDialogViewModel"
        Width="980" Height="600"
        MinWidth="760" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        Title="Performance Trends">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="8">
        <WrapPanel Grid.Row="0" Orientation="Horizontal" ItemHeight="24" ItemWidth="170">
            <CheckBox Content="Character speed" IsChecked="{Binding ShowCharacterSeries}"/>
            <CheckBox Content="Average speed" IsChecked="{Binding ShowAverageSeries}"/>
            <CheckBox Content="Error rate" IsChecked="{Binding ShowErrorSeries}"/>
            <CheckBox Content="Error limit" IsChecked="{Binding ShowLimitSeries}"/>
            <CheckBox Content="Noise" IsChecked="{Binding ShowNoiseSeries}"/>
        </WrapPanel>

        <controls:TrendsTimelineChart Grid.Row="1"
                                      Items="{Binding Points}"
                                      ShowCharacterSeries="{Binding ShowCharacterSeries}"
                                      ShowAverageSeries="{Binding ShowAverageSeries}"
                                      ShowErrorSeries="{Binding ShowErrorSeries}"
                                      ShowLimitSeries="{Binding ShowLimitSeries}"
                                      ShowNoiseSeries="{Binding ShowNoiseSeries}"
                                      HorizontalAlignment="Stretch"
                                      VerticalAlignment="Stretch"/>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Text="{Binding SummaryText}"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="Close"
                    MinWidth="100"
                    Command="{Binding CloseCommand}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#1D4ED8"
                    Foreground="White"/>
        </Grid>
    </Grid>
</Window>
