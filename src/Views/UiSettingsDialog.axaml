<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.UiSettingsDialog"
        x:DataType="vm:UiSettingsDialogViewModel"
        Width="420" Height="240"
        MinWidth="420" MinHeight="240"
        WindowStartupLocation="CenterOwner"
        Title="UI Settings">

    <Grid RowDefinitions="*,Auto" Margin="10">

        <GroupBox Grid.Row="0" Header="Text display" Margin="0,0,0,10"
                  CornerRadius="0" Background="#101010">
            <StackPanel Margin="10" Spacing="8">
                <TextBlock Text="Received text font"/>
                <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                    <ComboBox Grid.Column="0" Margin="0,0,6,0"
                              ItemsSource="{Binding AvailableFonts}"
                              SelectedItem="{Binding ReceivedTextFontFamily}"
                              HorizontalAlignment="Stretch"/>
                    <NumericUpDown Grid.Column="1" Width="120"
                                   Minimum="6" Maximum="72" Increment="1" FormatString="0"
                                   Value="{Binding ReceivedTextFontSize}"/>
                </Grid>
                <CheckBox Content="Reveal sent text after practice"
                          IsChecked="{Binding RevealSentTextAfterPractice}"/>
                <CheckBox Content="Use lowercase letters in received text"
                          IsChecked="{Binding UseLowercaseLetters}"/>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="5" HorizontalAlignment="Right">
            <Button Content="Save" MinWidth="90"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Background="#1D4ED8" Foreground="White"
                    Command="{Binding SaveCommand}"/>
            <Button Content="Cancel" MinWidth="90"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                    Command="{Binding CancelCommand}"/>
        </StackPanel>

    </Grid>
</Window>
