<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.InfoDialog"
        x:DataType="vm:InfoDialogViewModel"
        Title="{Binding Title}"
        Width="640" Height="260"
        MinWidth="520" MinHeight="220"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">

    <Grid RowDefinitions="Auto,*,Auto">
        <TextBlock Grid.Row="0"
                   Text="{Binding PrimaryMessage}"
                   FontSize="14"
                   TextWrapping="Wrap"
                   TextAlignment="Left"
                   HorizontalAlignment="Stretch"
                   Margin="10,10,10,8"/>

        <Border Grid.Row="1"
                IsVisible="{Binding HasDetail}"
                Background="#101010"
                Padding="10">
            <Grid RowDefinitions="Auto,*" RowSpacing="6">
                <TextBlock Grid.Row="0"
                           Text="{Binding DetailHeading}"
                           IsVisible="{Binding HasDetailHeading}"
                           TextAlignment="Left"
                           HorizontalAlignment="Stretch"
                           FontWeight="SemiBold"/>

                <SelectableTextBlock Grid.Row="1"
                                     Text="{Binding DetailMessage}"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonospaceFont}"
                                     MinHeight="70"
                                     HorizontalAlignment="Stretch"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="10"
                    Spacing="8">
            <Button Content="Do not show again"
                    IsVisible="{Binding HasDoNotShowAgain}"
                    Command="{Binding DoNotShowAgainCommand}"
                    MinWidth="160"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"/>
            <Button Content="OK"
                    Command="{Binding OkCommand}"
                    MinWidth="90"
                    IsDefault="True"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#1D4ED8"
                    Foreground="White"
                    HorizontalAlignment="Right"/>
        </StackPanel>
    </Grid>
</Window>
