<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.PracticeResultWindow"
        x:DataType="vm:PracticeResultWindowViewModel"
        Width="900" Height="620"
        MinWidth="700" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="Practice Result">

    <Grid RowDefinitions="*,Auto" Margin="12">
        <Border Grid.Row="0" BorderBrush="#2c2c2c" BorderThickness="1" CornerRadius="4">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Background="#1a1a1a" Margin="0,0,0,1">
                    <TextBlock Grid.Column="0" Text="Sent Groups" FontWeight="Bold" Margin="10,8"/>
                    <TextBlock Grid.Column="1" Text="Received Groups" FontWeight="Bold" Margin="10,8"/>
                    <TextBlock Grid.Column="2" Text="Differences" FontWeight="Bold" Margin="10,8"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,1" Background="#111">
                                    <TextBlock Grid.Column="0" Margin="10,6" Text="{Binding SentGroup}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="1" Margin="10,6" Text="{Binding ReceivedGroup}" TextWrapping="Wrap"/>
                                    <TextBlock Grid.Column="2" Margin="10,6" Text="{Binding Difference}" TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Border Grid.Row="1" Margin="0,10,0,0" Padding="10" Background="#101010" CornerRadius="4">
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                <TextBlock Grid.Column="0" Text="Character count:" FontWeight="Bold"/>
                <TextBlock Grid.Column="1" Text="{Binding CharacterCountText}"/>
                <TextBlock Grid.Column="2" Text="Errors:" FontWeight="Bold"/>
                <TextBlock Grid.Column="3" Text="{Binding ErrorsText}"/>
                <TextBlock Grid.Column="4" Text="Error rate:" FontWeight="Bold"/>
                <TextBlock Grid.Column="5" Text="{Binding ErrorRateText}"/>
            </Grid>
        </Border>
    </Grid>
</Window>
