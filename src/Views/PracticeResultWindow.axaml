<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.PracticeResultWindow"
        x:DataType="vm:PracticeResultWindowViewModel"
        Width="570" Height="620"
        MinWidth="570" MinHeight="320"
        WindowStartupLocation="CenterOwner"
        Title="Practice Result">

    <Window.Styles>
        <Style Selector="Button.save-results-button">
            <Setter Property="Background" Value="#1E88E5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#1565C0"/>
        </Style>

        <Style Selector="Button.save-results-button:disabled">
            <Setter Property="Background" Value="#7A7A7A"/>
            <Setter Property="Foreground" Value="#E0E0E0"/>
            <Setter Property="BorderBrush" Value="#666666"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="*,Auto" Margin="12">
        <Border Grid.Row="0" BorderBrush="#2c2c2c" BorderThickness="1" CornerRadius="0">
            <Grid RowDefinitions="Auto,*">
                <Grid Grid.Row="0" ColumnDefinitions="*,*,*" Background="#1a1a1a" Margin="0,0,0,1">
                    <TextBlock Grid.Column="0" Text="Sent groups" FontWeight="Bold" Margin="10,8"/>
                    <TextBlock Grid.Column="1" Text="Received groups" FontWeight="Bold" Margin="10,8"/>
                    <TextBlock Grid.Column="2" Text="Differences" FontWeight="Bold" Margin="10,8"/>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,1" Background="#111">
                                    <TextBlock Grid.Column="0" Margin="10,6" Text="{Binding SentGroup}" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                                    <TextBlock Grid.Column="1" Margin="10,6" Text="{Binding ReceivedGroup}" TextWrapping="Wrap" FontFamily="Consolas, monospace"/>
                                    <ItemsControl Grid.Column="2" Margin="10,6" ItemsSource="{Binding DifferenceSegments}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel Orientation="Horizontal"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Text}" Foreground="{Binding Kind, Converter={StaticResource DiffSegmentKindToBrush}}" FontFamily="Consolas, monospace"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <Border Grid.Column="0" Padding="10" Background="#101010" CornerRadius="0">
                <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="Character count:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="1" Text="{Binding CharacterCountText}"/>
                    <TextBlock Grid.Column="2" Text="Errors:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="3" Text="{Binding ErrorsText}" Foreground="{Binding ResultStatus, Converter={StaticResource StatusLevelToBrush}}"/>
                    <TextBlock Grid.Column="4" Text="Error rate:" FontWeight="Bold"/>
                    <TextBlock Grid.Column="5" Text="{Binding ErrorRateText}" Foreground="{Binding ResultStatus, Converter={StaticResource StatusLevelToBrush}}"/>
                </Grid>
            </Border>

            <Button Grid.Column="1"
                    Classes="save-results-button"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Padding="14,8"
                    MinWidth="120"
                    Background="#1D4ED8"
                    Foreground="White"                    
                    Command="{Binding SaveResultsCommand}"
                    Content="Save results"/>
        </Grid>
    </Grid>
</Window>
