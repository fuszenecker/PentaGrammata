<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PentaGrammata.ViewModels"
        x:Class="PentaGrammata.Views.AboutWindow"
    x:DataType="vm:AboutWindowViewModel"
        Width="520" Height="340"
        MinWidth="420" MinHeight="280"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/pentagrammata-icon.ico"
        Title="About PentaGrammata">

    <Grid RowDefinitions="*,60" Margin="0">
        <Border Background="#101010">
            <StackPanel Margin="20" VerticalAlignment="Center" HorizontalAlignment="Center">
            <Image Source="/Assets/pentagrammata-icon.png" Width="96" Height="96" HorizontalAlignment="Center"/>

            <TextBlock Text="PentaGrammata" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,10"/>

            <TextBlock Text="Morse practice with configurable character sets, audio settings, and detailed result analysis."
                       TextWrapping="Wrap" TextAlignment="Center" Foreground="#c9d1d9" Margin="0,0,0,10"/>

            <TextBlock Text="{Binding VersionText}" HorizontalAlignment="Center" Foreground="#9aa0a6"/>
        </StackPanel>
        </Border>

        <Button Grid.Row="1"
                Content="Close"
                Margin="0,0,10,0"
                MinWidth="100"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="#1D4ED8"
                Foreground="White"
                Command="{Binding CloseCommand}"/>
    </Grid>
</Window>
