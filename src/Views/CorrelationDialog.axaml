<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PentaGrammata.ViewModels"
        xmlns:controls="using:PentaGrammata.Views.Controls"
        x:Class="PentaGrammata.Views.CorrelationDialog"
        x:DataType="vm:CorrelationDialogViewModel"
        Width="820" Height="580"
        MinWidth="620" MinHeight="420"
        WindowStartupLocation="CenterOwner"
        Title="Error Rate Correlation">

    <Grid RowDefinitions="Auto,*,Auto" Margin="10" RowSpacing="8">
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="Analysis window (days)" VerticalAlignment="Center"
                           ToolTip.Tip="Only sessions recorded within this many days are correlated; 0 means today only."/>
                <NumericUpDown Width="130"
                               Minimum="{Binding MinWindowDays}"
                               Maximum="{Binding MaxWindowDays}"
                               Increment="1"
                               FormatString="0"
                               Value="{Binding WindowDays}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        ToolTip.Tip="One dot per session, dimmed with age: the oldest session in the window is the faintest.">
                <Ellipse Width="10" Height="10" Fill="#3987E5" VerticalAlignment="Center"/>
                <TextBlock Text="Session" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="#FFD24A" VerticalAlignment="Center"/>
                <TextBlock Text="Today" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Border Width="14" Height="3" CornerRadius="2" Background="#C98500" VerticalAlignment="Center"/>
                <TextBlock Text="Linear fit" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        ToolTip.Tip="One residual standard deviation either side of the fit: roughly two thirds of sessions land inside it.">
                <Border Width="14" Height="11" CornerRadius="2" Background="#C98500" Opacity="0.28" VerticalAlignment="Center"/>
                <TextBlock Text="±1 σ" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center"
                        ToolTip.Tip="The error threshold currently configured in the settings. Sessions above the line would count as failed.">
                <Border Width="14" Height="2" CornerRadius="1" Background="#E66767" VerticalAlignment="Center"/>
                <TextBlock Text="Error threshold" VerticalAlignment="Center"/>
            </StackPanel>
        </StackPanel>

        <TabControl Grid.Row="1" Padding="0">
            <TabItem Header="Speed" ToolTip.Tip="Error rate against the average speed, over every session.">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
                    <controls:CorrelationScatterChart Grid.Row="0"
                                                      Correlation="{Binding Speed.Correlation}"
                                                      ErrorThresholdPercent="{Binding ErrorThresholdPercent}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <TextBlock Grid.Row="1" Text="{Binding Speed.SummaryText}" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="Signal-to-noise" ToolTip.Tip="Error rate against the signal-to-noise ratio, over the sessions that had background noise.">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
                    <controls:CorrelationScatterChart Grid.Row="0"
                                                      Correlation="{Binding SignalToNoise.Correlation}"
                                                      ErrorThresholdPercent="{Binding ErrorThresholdPercent}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <TextBlock Grid.Row="1" Text="{Binding SignalToNoise.SummaryText}" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
            <TabItem Header="QSB depth" ToolTip.Tip="Error rate against the deepest QSB fade, over the sessions that had QSB.">
                <Grid RowDefinitions="*,Auto" RowSpacing="8" Margin="0,8,0,0">
                    <controls:CorrelationScatterChart Grid.Row="0"
                                                      Correlation="{Binding QsbDepth.Correlation}"
                                                      ErrorThresholdPercent="{Binding ErrorThresholdPercent}"
                                                      HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Stretch"/>
                    <TextBlock Grid.Row="1" Text="{Binding QsbDepth.SummaryText}" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>

        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Grid.Column="0"
                       Text="{Binding StatusText}"
                       IsVisible="{Binding HasStatus}"
                       Foreground="#E66767"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"/>

            <Button Grid.Column="1"
                    Content="Close"
                    MinWidth="100"
                    IsDefault="True"
                    Command="{Binding CloseCommand}"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Background="#1D4ED8"
                    Foreground="White"/>
        </Grid>
    </Grid>
</Window>
